<Window x:Class="SpinTexture.App.StagedPackLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpinTexture - Staged Pack Library"
        Width="1420" Height="880" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#08090C" Foreground="#F4F0E7"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111318" />
        <SolidColorBrush x:Key="PanelRaised" Color="#171A20" />
        <SolidColorBrush x:Key="PanelInset" Color="#0B0D11" />
        <SolidColorBrush x:Key="Border" Color="#303641" />
        <SolidColorBrush x:Key="Muted" Color="#B7BBC3" />
        <SolidColorBrush x:Key="Safe" Color="#79E2B5" />
        <SolidColorBrush x:Key="Warning" Color="#F8CE77" />
        <SolidColorBrush x:Key="Accent" Color="#FF8A47" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242830" />
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="BorderBrush" Value="#454D59" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#323944" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#687587" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1C1F25" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface"
                                Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="9" Padding="2">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#1A1F27" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#49515E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#252C37" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="STAGED PACK LIBRARY" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Choose, inspect, repair, or remove completed packs"
                           FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="Checkmarks define the next install set. Highlighted rows are for preview, repair, and deletion; Ctrl/Shift-click highlights several rows."
                           Style="{StaticResource Caption}" FontSize="13" Margin="0,7,18,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh Library" Click="Refresh_Click"
                    VerticalAlignment="Bottom" Margin="12,0,0,0"
                    ToolTip="Rescan completed packs without changing the game client." />
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="12,10"
                Background="#0D1015" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="STATUS KEY" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Border Background="#17352B" BorderBrush="#356A57" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                    <TextBlock Text="ACTIVE" Foreground="{StaticResource Safe}" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="installed now" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Background="#20252C" BorderBrush="#4A525E" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                    <TextBlock Text="STAGED" Foreground="#E9EDF3" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="reusable build" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Background="#382B18" BorderBrush="#785C2F" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                    <TextBlock Text="REPAIR AVAILABLE" Foreground="{StaticResource Warning}" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="focused pack can be upgraded" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Background="#451F22" BorderBrush="#8A4149" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                    <TextBlock Text="SOURCE MISMATCH" Foreground="#FFB9BE" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="repair before install" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.17*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.83*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="3,1,3,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1 / BUILD THE INSTALL SET" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Completed packs by category" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                            <TextBlock Text="Click a row for focused details. Ctrl/Shift-click several rows, then use the bulk controls below."
                                       Style="{StaticResource Caption}" Margin="0,4,16,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectionText}" Foreground="{StaticResource Safe}"
                                   FontSize="12" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource PanelInset}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="7" Padding="10,10,4,2" Margin="0,0,0,11">
                        <WrapPanel>
                            <Button Content="Check Highlighted" Style="{StaticResource ToolbarButton}"
                                    Click="CheckHighlighted_Click" IsEnabled="{Binding CanCheckHighlighted}"
                                    ToolTip="Add every highlighted installable row to the install set." />
                            <Button Content="Uncheck Highlighted" Style="{StaticResource ToolbarButton}"
                                    Click="UncheckHighlighted_Click" IsEnabled="{Binding CanUncheckHighlighted}"
                                    ToolTip="Remove every highlighted installable row from the install set." />
                            <Button Content="Keep Current + Highlighted" Style="{StaticResource ToolbarButton}"
                                    Click="AddHighlightedToCurrent_Click" IsEnabled="{Binding CanAddHighlightedToCurrent}"
                                    Background="#1A3028" BorderBrush="#356A57"
                                    ToolTip="Keep every currently active source component checked and add the highlighted rows." />
                            <Button Content="Use Current Only" Style="{StaticResource ToolbarButton}"
                                    Click="CheckCurrentInstall_Click" IsEnabled="{Binding CanCheckCurrentInstall}"
                                    ToolTip="Reset checkmarks to the source packs that make up the current enhanced install." />
                            <Button Content="Check All Eligible" Style="{StaticResource ToolbarButton}"
                                    Click="CheckAll_Click" IsEnabled="{Binding CanCheckAll}"
                                    ToolTip="Check every source pack. Conflicting archives are still blocked safely before install." />
                            <Button Content="Clear Checks" Style="{StaticResource ToolbarButton}"
                                    Click="ClearChecks_Click" IsEnabled="{Binding CanClearChecks}" />
                        </WrapPanel>
                    </Border>

                    <ListBox x:Name="PackList" Grid.Row="2"
                             ItemsSource="{Binding PacksView}"
                             SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                             SelectionMode="Extended"
                             SelectionChanged="PackList_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             AutomationProperties.Name="Completed staged packs">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1015" BorderBrush="#3A414C" BorderThickness="0,0,0,1"
                                                Padding="9,8" Margin="0,8,0,9">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="#FFA56F"
                                                           FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0:N0} PACK(S)}"
                                                           HorizontalAlignment="Right" Foreground="#9AA1AC"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelRaised}" BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                  ToolTip="{Binding SelectionHint}" VerticalAlignment="Top"
                                                  Margin="0,3,14,0" Padding="2"
                                                  AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="INSTALL" Foreground="#E9EDF3" FontSize="11" FontWeight="Bold" />
                                                <TextBlock Text="SET" Foreground="#AAB0BA" FontSize="10" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Foreground="#F9F7F2"
                                                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="8,4" CornerRadius="4" Background="{Binding BadgeBackground}"
                                                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeForeground}"
                                                               FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Details}" Foreground="#D0D4DB" FontSize="13"
                                                       Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19" />
                                            <Border Background="#101319" BorderBrush="#2D333D" BorderThickness="1"
                                                    CornerRadius="5" Padding="9,7" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Safe}"
                                                           FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                            </Border>
                                            <Border Background="#382B18" BorderBrush="#785C2F" BorderThickness="1"
                                                    CornerRadius="5" Padding="9,8" Margin="0,8,0,0"
                                                    Visibility="{Binding CanRepair, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RepairButtonText, StringFormat={}{0} AVAILABLE}"
                                                               Foreground="{StaticResource Warning}" FontSize="11" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding RepairStatusText}" Foreground="#F5DEAB"
                                                               FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#451F22" BorderBrush="#8A4149" BorderThickness="1"
                                                    CornerRadius="5" Padding="9,8" Margin="0,8,0,0"
                                                    Visibility="{Binding CanRepairSourceMismatch, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="SOURCE MISMATCH - REPAIR BEFORE INSTALL"
                                                               Foreground="#FFB9BE" FontSize="11" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding SourceRepairStatusText}" Foreground="#FFD5D8"
                                                               FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding SelectionHint}" Foreground="#9FA6B1" FontSize="11"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="2 / FOCUSED DETAILS + MANAGEMENT" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Inspect one; manage one or many" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding HighlightedSelectionText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource PanelInset}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,13,0,11">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPack.Title, TargetNullValue=Highlight a pack to inspect it.}"
                                       FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPack.ContentsSummary, TargetNullValue='Preview, repair, and source-repair actions apply only to the focused pack. Delete applies to every highlighted row after a fresh safety preflight.'}"
                                       Foreground="#D2D6DD" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <WrapPanel>
                            <Button Content="Open Focused Preview" Click="Preview_Click" IsEnabled="{Binding CanPreview}"
                                    Background="#193027" BorderBrush="#356A57" />
                            <Button Content="{Binding SelectedPack.RepairButtonText, TargetNullValue=Repair Focused Pack}"
                                    Click="Repair_Click" IsEnabled="{Binding CanRepair}"
                                    Background="#26324A" BorderBrush="#526D9E" />
                            <Button Content="Repair Focused Source" Click="RepairSourceMismatch_Click"
                                    IsEnabled="{Binding CanRepairSourceMismatch}"
                                    Background="#382B18" BorderBrush="#785C2F" />
                            <Button Content="Delete Highlighted..." Click="Delete_Click" IsEnabled="{Binding CanDelete}"
                                    Background="#3A1D20" BorderBrush="#8C4A53" Foreground="#FFDADD"
                                    ToolTip="Preflight and permanently delete every highlighted pack. Active or referenced packs block the whole operation." />
                        </WrapPanel>
                        <TextBlock Text="Preview and repair use the focused row. Delete uses every orange-highlighted row and never touches live game files."
                                   Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,9" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="ARCHIVES IN FOCUSED PACK" Foreground="{StaticResource Muted}"
                                   FontSize="11" FontWeight="Bold" Margin="2,2,0,8" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPack.ArtifactPaths}"
                                 Background="#0B0D11" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Archives in focused pack">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#C8CDD5" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" Margin="10,5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#0D1015" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Safe}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Height="6" Margin="16,0,0,0"
                                 IsIndeterminate="{Binding IsBusy}" Background="#242A32"
                                 Foreground="{StaticResource Accent}" BorderThickness="0" />
                </Grid>
                <CheckBox Grid.Row="1" IsChecked="{Binding IsInstallAcknowledged}" Margin="0,10,0,0">
                    <TextBlock Text="I reviewed the checkmarked install set and understand that installing custom client files may be unsupported."
                               TextWrapping="Wrap" FontSize="12" Foreground="#CDD1D8" />
                </CheckBox>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}"
                               FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               VerticalAlignment="Center" Margin="0,0,18,0" />
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Cancel Operation" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" />
                        <Button Content="Close" Click="Close_Click" IsEnabled="{Binding CanClose}" />
                        <Button Content="Verify + Install Checkmarked Set" Click="Install_Click"
                                IsEnabled="{Binding CanInstall}" IsDefault="True"
                                Background="#9B3B16" BorderBrush="#F1793D" Foreground="White"
                                ToolTip="Exact-verify, conflict-check, and install only the checkmarked set. AI upscaling is not rerun." />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
