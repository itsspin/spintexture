<UserControl x:Class="SpinTexture.App.StagedPackLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#08090C" Foreground="#F4F0E7"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111318" />
        <SolidColorBrush x:Key="PanelRaised" Color="#171A20" />
        <SolidColorBrush x:Key="PanelInset" Color="#0B0D11" />
        <SolidColorBrush x:Key="Border" Color="#303641" />
        <SolidColorBrush x:Key="Muted" Color="#B7BBC3" />
        <SolidColorBrush x:Key="Safe" Color="#79E2B5" />
        <SolidColorBrush x:Key="Warning" Color="#F8CE77" />
        <SolidColorBrush x:Key="Accent" Color="#FF8A47" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242830" />
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="BorderBrush" Value="#454D59" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#323944" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#687587" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1C1F25" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface"
                                Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="9" Padding="2">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#1A1F27" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#49515E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#252C37" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F0E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MANAGE TEXTURE PACKS" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Choose which completed packs should be active"
                           FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="A checkmark means “include this pack the next time I install.” Clicking the rest of a row only opens its details; it does not add or remove that pack."
                           Style="{StaticResource Caption}" FontSize="13" Margin="0,7,18,0" />
                <TextBlock Text="{Binding PackStorageText}" Foreground="#8FA6A1" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,6,18,0"
                           ToolTip="Change this location from Pack Storage Settings on the main window." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clean Up Leftovers" Click="CleanupDebris_Click"
                        IsEnabled="{Binding CanCleanupDebris}" Margin="12,0,0,0"
                        ToolTip="Find and remove folders left behind by interrupted builds. Completed packs and resumable builds are never touched." />
                <Button Content="Refresh Library" Click="Refresh_Click"
                        Margin="8,0,0,0"
                        ToolTip="Rescan completed packs without changing the game client." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="12,10"
                Background="#0D1015" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="QUICK GUIDE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="1  Check packs" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="2  Review the summary" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="3  Install checked packs" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0" />
                <Border Background="#17352B" BorderBrush="#356A57" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                    <TextBlock Text="ACTIVE" Foreground="{StaticResource Safe}" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="installed now" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Background="#20252C" BorderBrush="#4A525E" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                    <TextBlock Text="STAGED" Foreground="#E9EDF3" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="saved and reusable" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.17*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.83*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="3,1,3,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1 / CHECK PACKS TO INCLUDE" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Available completed packs" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                            <TextBlock Text="Use the checkbox inside each card. To manage several cards at once, Ctrl/Shift-click their rows so they have an orange outline."
                                       Style="{StaticResource Caption}" Margin="0,4,16,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="210">
                            <TextBlock Text="SHOW CATEGORY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" />
                            <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}"
                                      Margin="0,5,0,7" AutomationProperties.Name="Pack category filter" />
                            <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Safe}"
                                       FontSize="11" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Expander Grid.Row="1" Header="Advanced multi-pack selection tools" Margin="0,0,0,11"
                              Foreground="#D9DDE4" ToolTip="Most users only need the checkbox in each pack card.">
                        <Border Background="{StaticResource PanelInset}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="7" Padding="10,10,4,2" Margin="0,7,0,0">
                            <WrapPanel>
                                <Button Content="Add Highlighted to Install" Style="{StaticResource ToolbarButton}"
                                        Click="CheckHighlighted_Click" IsEnabled="{Binding CanCheckHighlighted}" />
                                <Button Content="Remove Highlighted from Install" Style="{StaticResource ToolbarButton}"
                                        Click="UncheckHighlighted_Click" IsEnabled="{Binding CanUncheckHighlighted}" />
                                <Button Content="Keep Active + Add Highlighted" Style="{StaticResource ToolbarButton}"
                                        Click="AddHighlightedToCurrent_Click" IsEnabled="{Binding CanAddHighlightedToCurrent}"
                                        Background="#1A3028" BorderBrush="#356A57" />
                                <Button Content="Reset Checks to Active Packs" Style="{StaticResource ToolbarButton}"
                                        Click="CheckCurrentInstall_Click" IsEnabled="{Binding CanCheckCurrentInstall}" />
                                <Button Content="Check Every Compatible Pack" Style="{StaticResource ToolbarButton}"
                                        Click="CheckAll_Click" IsEnabled="{Binding CanCheckAll}" />
                                <Button Content="Clear All Checkmarks" Style="{StaticResource ToolbarButton}"
                                        Click="ClearChecks_Click" IsEnabled="{Binding CanClearChecks}" />
                            </WrapPanel>
                        </Border>
                    </Expander>

                    <Grid Grid.Row="2">
                        <TextBlock Text="No completed packs yet.&#x0a;&#x0a;Build one from the main window: choose your EverQuest folder, click Analyze Client, pick a zone and a texture style, then Build Staged Pack. Completed packs appear here, ready to verify and install — building never touches the live game."
                                   Foreground="#9AA3B2" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox x:Name="PackList"
                             ItemsSource="{Binding PacksView}"
                             SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                             SelectionMode="Extended"
                             SelectionChanged="PackList_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             AutomationProperties.Name="Completed staged packs">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1015" BorderBrush="#3A414C" BorderThickness="0,0,0,1"
                                                Padding="9,8" Margin="0,8,0,9">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="#FFA56F"
                                                           FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0:N0} PACK(S)}"
                                                           HorizontalAlignment="Right" Foreground="#9AA1AC"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelRaised}" BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                  ToolTip="{Binding SelectionHint}" VerticalAlignment="Top"
                                                  Margin="0,3,14,0" Padding="2"
                                                  AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="INCLUDE" Foreground="#E9EDF3" FontSize="11" FontWeight="Bold" />
                                                <TextBlock Text="WHEN INSTALLING" Foreground="#AAB0BA" FontSize="9" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Foreground="#F9F7F2"
                                                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Padding="8,4" CornerRadius="4" Background="{Binding BadgeBackground}"
                                                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeForeground}"
                                                               FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Details}" Foreground="#D0D4DB" FontSize="13"
                                                       Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19" />
                                            <Border Background="#101319" BorderBrush="#2D333D" BorderThickness="1"
                                                    CornerRadius="5" Padding="9,7" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Safe}"
                                                           FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                            </Border>
                                            <Border Background="{Binding RepairPanelBackground}" BorderBrush="{Binding RepairPanelBorderBrush}" BorderThickness="1"
                                                    CornerRadius="5" Padding="9,8" Margin="0,8,0,0"
                                                    Visibility="{Binding CanRepairAny, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RepairBadgeText}"
                                                               Foreground="{Binding RepairStatusForeground}" FontSize="11" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding RepairStatusText}" Foreground="{Binding RepairStatusForeground}"
                                                               FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding SelectionHint}" Foreground="#9FA6B1" FontSize="11"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="2 / FOCUSED PACK" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Review, repair, or remove one pack" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding HighlightedSelectionText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource PanelInset}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,13,0,11">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPack.Title, TargetNullValue=Click a pack card to see its details.}"
                                       FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPack.ContentsSummary, TargetNullValue='The checkbox controls installation. Clicking a card controls which pack is shown here. Ctrl/Shift-click several cards only when you want a bulk action.'}"
                                       Foreground="#D2D6DD" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <WrapPanel>
                            <Button Content="Open This Pack’s Preview" Click="Preview_Click" IsEnabled="{Binding CanPreview}"
                                    Background="#193027" BorderBrush="#356A57" />
                            <Button Content="Rename Pack" Click="Rename_Click" IsEnabled="{Binding CanRename}"
                                    ToolTip="Give the focused pack a custom display name. The name is stored beside the pack (pack-meta.json) and never changes its contents, identity, or install." />
                            <Button Content="Repair Checked Packs"
                                    Click="RepairCheckedPacks_Click" IsEnabled="{Binding CanRepairCheckedPacks}"
                                    Background="#382B18" BorderBrush="#785C2F"
                                    ToolTip="Repairs every checked source pack that needs an update. Source mismatches run first; completed replacements stay checked if a later pack fails." />
                            <Button Content="Repair Pack"
                                    Click="Repair_Click" IsEnabled="{Binding CanRepairAny}"
                                    ToolTip="Repairs the focused pack named above. Checkmarks do not control this button. The completed original remains unchanged."
                                    Background="#26324A" BorderBrush="#526D9E" />
                            <Button Content="{Binding DeleteButtonText}" Click="Delete_Click" IsEnabled="{Binding CanDelete}"
                                    Background="#3A1D20" BorderBrush="#8C4A53" Foreground="#FFDADD"
                                    ToolTip="Preflight and permanently delete every highlighted pack. Active or referenced packs block the whole operation." />
                        </WrapPanel>
                        <TextBlock Text="Repair Checked Packs is the simplest fix for an installed combination: affected checked source packs are replaced safely. Preview and Repair Pack affect only the focused pack named above. Delete affects every orange-outlined row. None of these actions deletes live game files or original backups."
                                   Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,9" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="GAME ARCHIVES PROVIDED BY THIS PACK" Foreground="{StaticResource Muted}"
                                   FontSize="11" FontWeight="Bold" Margin="2,2,0,8" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPack.ArtifactPaths}"
                                 Background="#0B0D11" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Archives in focused pack">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#C8CDD5" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" Margin="10,5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#0D1015" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Safe}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Height="6" Margin="16,0,0,0"
                                 IsIndeterminate="{Binding IsBusy}" Background="#242A32"
                                 Foreground="{StaticResource Accent}" BorderThickness="0" />
                </Grid>
                <CheckBox Grid.Row="1" IsChecked="{Binding IsInstallAcknowledged}" Margin="0,10,0,0">
                    <TextBlock Text="I reviewed the checked packs above and understand that installing custom client files may be unsupported."
                               TextWrapping="Wrap" FontSize="12" Foreground="#CDD1D8" />
                </CheckBox>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}"
                               FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               VerticalAlignment="Center" Margin="0,0,18,0" />
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Cancel Operation" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" />
                        <Button Content="Back to Build" Click="Close_Click" IsEnabled="{Binding CanClose}" />
                        <Button Content="{Binding InstallButtonText}" Click="Install_Click"
                                IsEnabled="{Binding CanInstall}" IsDefault="True"
                                Background="#9B3B16" BorderBrush="#F1793D" Foreground="White"
                                ToolTip="Exact-verify, conflict-check, and install only the checkmarked set. AI upscaling is not rerun." />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
