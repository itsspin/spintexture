<Window x:Class="SpinTexture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SpinTexture.App.Converters"
        mc:Ignorable="d"
        Title="SpinTexture - Lavastorm Texture Forge"
        Width="1440"
        Height="900"
        MinWidth="1160"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#090A0D"
        Foreground="#F5F1E8"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090A0D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111318" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#17191F" />
        <SolidColorBrush x:Key="PanelInsetBrush" Color="#0C0E12" />
        <SolidColorBrush x:Key="BorderBrush" Color="#292D35" />
        <SolidColorBrush x:Key="BorderBrightBrush" Color="#3B414B" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F0E7" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8BBC2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8F99" />
        <SolidColorBrush x:Key="LavaBrush" Color="#FF5A1F" />
        <SolidColorBrush x:Key="LavaBrightBrush" Color="#FF8A3D" />
        <SolidColorBrush x:Key="LavaDimBrush" Color="#442016" />
        <SolidColorBrush x:Key="SafeBrush" Color="#65D6A6" />
        <SolidColorBrush x:Key="SafeDimBrush" Color="#16372D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F5C76B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B72" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:RevealPositionConverter x:Key="RevealPositionConverter" />
        <converters:RevealClipConverter x:Key="RevealClipConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LavaBrightBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="InsetStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#242830" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#3A3F49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303640" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#555D69" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C1F25" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource LavaBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LavaBrightBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,12" />
        </Style>

        <Style x:Key="SafeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#183C32" />
            <Setter Property="BorderBrush" Value="#2D715C" />
            <Setter Property="Foreground" Value="#C9F8E7" />
            <Setter Property="Padding" Value="18,12" />
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource LavaBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource LavaBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            WPF's stock ComboBox template pulls colors from the Windows theme. On a
            dark surface that can produce a white field with white text (or black
            text in the popup), so the complete control is themed here rather than
            relying on a few foreground setters.
        -->
        <Style x:Key="DarkComboBoxToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface" Background="Transparent">
                            <Grid Width="38">
                                <Border Width="1" Height="21" HorizontalAlignment="Left"
                                        Background="#323741" />
                                <Path x:Name="Arrow"
                                      Width="10" Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,0 L 5,5 L 10,0 Z"
                                      Fill="{StaticResource SecondaryTextBrush}"
                                      Stretch="Fill" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background" Value="#22262D" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource LavaBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background" Value="#291A14" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource LavaBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Arrow" Property="Fill" Value="#666B74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MaxDropDownHeight" Value="310" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" />

                            <Grid Margin="{TemplateBinding BorderThickness}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="EmptySelectionHint"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Text="Select an option..."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontWeight="Normal"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource DarkComboBoxToggleStyle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border x:Name="PopupBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=ComboRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="#15181E"
                                        BorderBrush="#505761"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="EmptySelectionHint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#606873" />
                                <Setter TargetName="ComboBorder" Property="Background" Value="#11141A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource LavaBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource LavaBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#0E1014" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#252A31" />
                                <Setter Property="Foreground" Value="#777C86" />
                                <Setter TargetName="EmptySelectionHint" Property="Foreground" Value="#666B74" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#252A32" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#414852" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#352018" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource LavaBrush}" />
                                <Setter Property="Foreground" Value="#FFF8EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#70757E" />
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PresetItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PresetBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetBorder" Property="BorderBrush" Value="#555C66" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PresetBorder" Property="Background" Value="#251813" />
                                <Setter TargetName="PresetBorder" Property="BorderBrush" Value="{StaticResource LavaBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CapBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CapBorder" Property="Background" Value="{StaticResource LavaDimBrush}" />
                                <Setter TargetName="CapBorder" Property="BorderBrush" Value="{StaticResource LavaBrightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0C0E12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>

        <!-- Lava atmosphere behind the header. -->
        <Grid Grid.Row="0" Height="112" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1C100C" Offset="0" />
                    <GradientStop Color="#101216" Offset="0.48" />
                    <GradientStop Color="#161014" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="600" Height="250" HorizontalAlignment="Left" Margin="-180,-165,0,0" Opacity="0.62">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B94B21" Offset="0" />
                        <GradientStop Color="#00161210" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Rectangle Height="2" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FF5A1F" Offset="0" />
                        <GradientStop Color="#FFFF5A1F" Offset="0.16" />
                        <GradientStop Color="#44FF8A3D" Offset="0.58" />
                        <GradientStop Color="#00FF5A1F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="12" VerticalAlignment="Center"
                        Background="#2B1710" BorderBrush="#B94B21" BorderThickness="1">
                    <Grid>
                        <Path Data="M 9,40 L 20,17 L 29,31 L 37,10 L 48,40 Z"
                              Fill="#FF5A1F" Stretch="Uniform" Margin="10" />
                        <Path Data="M 20,39 L 27,28 L 32,35 L 37,24 L 42,39 Z"
                              Fill="#FFC06A" Stretch="Uniform" Margin="13" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SPINTEXTURE" FontSize="25" FontWeight="Bold" />
                        <Border Margin="11,3,0,3" Padding="8,2" CornerRadius="4" Background="{StaticResource LavaDimBrush}">
                            <TextBlock Text="LAVASTORM FORGE" Style="{StaticResource EyebrowTextStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0"
                               Text="A faithful texture enhancement workshop built specifically for EverQuest Legends"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BuildNavButton" Content="Build" Click="BuildNav_Click" Padding="13,8" Margin="0,0,7,0"
                            ToolTip="Choose a scope, style, quality ceiling, and build a staged pack." />
                    <Button x:Name="PacksNavButton" Content="Packs" Click="PacksNav_Click" Padding="13,8" Margin="0,0,7,0"
                            ToolTip="Choose which completed packs are installed, repair older packs, or remove unneeded packs." />
                    <Button x:Name="ReviewNavButton" Content="Review" Click="ReviewNav_Click" Padding="13,8" Margin="0,0,7,0"
                            ToolTip="Compare original and enhanced textures in the latest staged pack." />
                    <Button x:Name="GraphicsNavButton" Content="Graphics" Click="GraphicsNav_Click" Padding="13,8" Margin="0,0,7,0"
                            ToolTip="Configure verified native lighting, shadows, and bloom without injection." />
                    <Button x:Name="StorageNavButton" Content="Storage" Click="StorageNav_Click" Padding="13,8"
                            Margin="0,0,7,0" ToolTip="Choose where reusable staged packs are stored." />
                    <Button Content="Updates" Click="UpdatesNav_Click" Padding="13,8" Margin="0,0,7,0"
                            AutomationProperties.Name="Check for SpinTexture updates"
                            ToolTip="Check GitHub for a newer stable SpinTexture release." />
                    <Border Padding="8,6" CornerRadius="5"
                            VerticalAlignment="Center" Background="#151920"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            ToolTip="The SpinTexture version currently installed.">
                        <TextBlock x:Name="InstalledVersionText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   AutomationProperties.Name="Installed SpinTexture version" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="BuildPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,22,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="338" />
                </Grid.ColumnDefinitions>

                <!-- Source and scope -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="01 / SOURCE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Find the Legends client" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,4" />
                            <TextBlock Text="Analysis is inventory-only. It reads names and sizes, then leaves every client file untouched."
                                       Style="{StaticResource CaptionStyle}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}" ToolTip="EverQuest Legends installation folder" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}" ToolTip="Browse for the client folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" />
                                        <TextBlock Text="Browse" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="5" Background="#0D1916" BorderBrush="#1E4136" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SafeBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PathStateText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Button Margin="0,12,0,0" Command="{Binding AnalyzeCommand}" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Analyze Client (Read Only)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="02 / SCOPE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Choose what to forge" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,12" />

                            <TextBlock Text="ASSET SET" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding ScopeOptions}"
                                      SelectedItem="{Binding SelectedScopeOption}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Asset set" />
                            <TextBlock Margin="1,7,1,0" Text="{Binding SelectedScopeOption.Description}" Style="{StaticResource CaptionStyle}" />

                            <TextBlock Text="ZONE  /  QUICK SELECT" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,0" />
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding Zones}"
                                      SelectedItem="{Binding SelectedZone}"
                                      IsEnabled="{Binding IsZoneSelectionEnabled}"
                                      ToolTip="Choose a zone to automatically switch Asset Set to Selected zone."
                                      AutomationProperties.Name="Zone quick select" />
                            <TextBlock Margin="1,7,1,0"
                                       Text="{Binding ZoneSelectionStatusText}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CLIENT INVENTORY" Style="{StaticResource EyebrowTextStyle}" />
                                <Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Background="#202329">
                                    <TextBlock Text="{Binding AnalysisStateText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ARCHIVES" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding ArchiveCountText}" Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LOOSE TEXTURES" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding LooseTextureCountText}" Style="{StaticResource MetricValueStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PACKED INDEX" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding PackedTextureCountText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FOOTPRINT" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding SourceFootprintText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Presets and output -->
                <StackPanel Grid.Column="1" Margin="14,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="03 / ENHANCEMENT PROFILE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Keep the era. Recover the detail." Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,4" />
                            <TextBlock Text="Choose the art direction first. Every route keeps format, alpha, mip, and archive safety; protected assets remain original."
                                       Style="{StaticResource CaptionStyle}" />

                            <ListBox Margin="0,17,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding PresetOptions}"
                                     SelectedItem="{Binding SelectedPresetOption}"
                                     ItemContainerStyle="{StaticResource PresetItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="15" MinHeight="150">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource EyebrowTextStyle}" />
                                                <Border HorizontalAlignment="Right" Padding="6,2" CornerRadius="4" Background="{StaticResource LavaDimBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="RECOMMENDED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource LavaBrightBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,9,0,6" />
                                            <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap" LineHeight="17" />
                                            <TextBlock Grid.Row="3" Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,14,0,0" Padding="13" CornerRadius="7"
                                    Background="#17131A" BorderBrush="#6A3A25" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGraphicPaintedSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="PAINTED THEME" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Margin="0,6,0,0"
                                                  ItemsSource="{Binding PaintedThemeOptions}"
                                                  SelectedItem="{Binding SelectedPaintedThemeOption}"
                                                  DisplayMemberPath="Name"
                                                  AutomationProperties.Name="Graphic Painted Fantasy theme" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPaintedThemeOption.Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding SelectedPaintedThemeOption.Description}"
                                                   Margin="0,5,0,0" Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap" LineHeight="17" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="13" CornerRadius="7" Background="#0D1117"
                                    BorderBrush="#343B46" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="ACTUAL MODEL ROUTE" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedPresetOption.Model}" Margin="0,5,0,0" FontSize="11"
                                                   FontFamily="Cascadia Mono" Foreground="#E7EAF0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="VISUAL DIRECTION" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedPresetOption.Look}" Margin="0,5,0,0" FontSize="11"
                                                   Foreground="#E7EAF0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PERFORMANCE" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedPresetOption.Performance}" Margin="0,5,0,0" FontSize="11"
                                                   Foreground="#E7EAF0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Margin="2,10,2,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                       Text="For an accurate example, build one Selected zone. Texture Review opens real original/enhanced images from your own client; safety fallbacks are reported instead of hidden." />
                            <Border Visibility="Collapsed" Margin="0,13,0,0" Padding="10" CornerRadius="7" Background="#0A0D11"
                                    BorderBrush="#303640" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="132" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="REAL IN-GAME REFERENCE · TEXTURE HD" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="Captured from the original and enhanced clients" HorizontalAlignment="Right"
                                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#111318" BorderBrush="#3B414B" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                            <Grid>
                                                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="7,3" CornerRadius="3" Background="#D0101114">
                                                    <TextBlock Text="ORIGINAL" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Background="#111318" BorderBrush="#356A57" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                            <Grid>
                                                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="7,3" CornerRadius="3" Background="#D016372D">
                                                    <TextBlock Text="TEXTURE HD" Foreground="{StaticResource SafeBrush}" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Margin="1,8,1,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                               Text="This pair demonstrates the recommended default only. Graphic Painted Fantasy, Rustic Painted, and Material Detail previews are generated from your own selected-zone build so SpinTexture never substitutes a marketing mockup for actual output." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="04 / TEXTURE CEILING" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Upscale ceiling (longest edge)" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,4" />
                                <TextBlock Text="This is a size limit, not a target. SpinTexture performs one meaningful up-to-4x restoration pass and preserves aspect ratio."
                                           Style="{StaticResource CaptionStyle}" />
                                <ListBox Margin="0,16,0,0"
                                         Background="Transparent"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         BorderThickness="0"
                                         ItemsSource="{Binding TextureCaps}"
                                         SelectedItem="{Binding SelectedMaximumDimension}"
                                         ItemContainerStyle="{StaticResource CapItemStyle}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding StringFormat={}{0:N0}}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="PX" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="2,10,2,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                           Text="1,024 saves space  •  2,048 is recommended  •  4,096 helps only when the source is over 512 px. Sources at 512 px or below usually produce the same top level at 2K and 4K." />
                                <CheckBox Margin="2,15,0,0" IsChecked="{Binding GenerateMipMaps}">
                                    <StackPanel>
                                        <TextBlock Text="Generate DDS mip chains (recommended)" FontWeight="SemiBold" />
                                        <TextBlock Text="Separate from upscale size. Smaller DDS levels reduce distance shimmer; alpha cutouts stay top-level only for legacy-renderer safety." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="QUALITY GUARDRAILS" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="Faithful by construction" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,12" />
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SafeBrush}" />
                                        <TextBlock Grid.Column="1" Text="Preserve aspect ratio, DDS family, and alpha intent" Style="{StaticResource CaptionStyle}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SafeBrush}" />
                                        <TextBlock Grid.Column="1" Text="Protect UI, effects, masks, packed atlases, and technical maps" Style="{StaticResource CaptionStyle}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SafeBrush}" />
                                        <TextBlock Grid.Column="1" Text="Verify exact mip chains, archive structure, and SHA-256 manifests" Style="{StaticResource CaptionStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Opt-in, client-derived comparison. Collapsed previews do no work. -->
                    <Border x:Name="LivePreviewCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                            DataContext="{Binding OptionPreview}"
                            AutomationProperties.Name="Live texture preview">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LIVE SETTINGS PREVIEW" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="See it before you forge it" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,4" />
                                    <TextBlock Text="Creates up to three genuine examples from this client with the selected profile. It never substitutes bundled artwork or builds a staged pack."
                                               Style="{StaticResource CaptionStyle}" MaxWidth="690" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleExpandedCommand}"
                                        Margin="18,0,0,0" Padding="14,9" VerticalAlignment="Center"
                                        AutomationProperties.Name="Show or hide live texture preview"
                                        ToolTip="Generate or close the client-derived settings preview">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ToggleButtonText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="8,4" CornerRadius="10" Background="#241914" BorderBrush="#63331F" BorderThickness="1">
                                    <TextBlock Text="{Binding ProfileChipText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LavaBrightBrush}" />
                                </Border>
                                <Border Grid.Column="1" Margin="7,0,0,0" Padding="8,4" CornerRadius="10" Background="#151B23" BorderBrush="#334356" BorderThickness="1">
                                    <TextBlock Text="{Binding CapChipText}" FontSize="9" FontWeight="Bold" Foreground="#A8CBEF" />
                                </Border>
                                <Border Grid.Column="2" Margin="7,0,0,0" Padding="8,4" CornerRadius="10" Background="#132019" BorderBrush="#305341" BorderThickness="1">
                                    <TextBlock Text="{Binding MipChipText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Margin="12,0,0,0"
                                           Style="{StaticResource CaptionStyle}" TextAlignment="Right"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,14,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Loading / option-change state -->
                                <Border Padding="18" MinHeight="116" Background="#0D1117" BorderBrush="#343B46"
                                        BorderThickness="1" CornerRadius="8"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.LiveSetting="Polite">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                                        <TextBlock Text="Rendering your selected settings" Margin="0,13,0,0"
                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ProgressText}" Margin="0,4,0,0" Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- No-analysis / paused hint remains useful when the panel is open without work. -->
                                <Border Padding="18" Background="#10151B" BorderBrush="#354453" BorderThickness="1" CornerRadius="8"
                                        Visibility="{Binding ShowExpandedHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Preview is waiting" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Actionable error state -->
                                <Border Padding="16" Background="#211315" BorderBrush="#6F3036" BorderThickness="1" CornerRadius="8"
                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.LiveSetting="Assertive">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Preview unavailable" FontSize="13" FontWeight="SemiBold" Foreground="#FFB5BA" />
                                            <TextBlock Text="{Binding ErrorText}" Margin="0,5,12,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="Try again"
                                                VerticalAlignment="Center" AutomationProperties.Name="Retry live texture preview" />
                                    </Grid>
                                </Border>

                                <!-- Honest empty result state -->
                                <Border Padding="18" Background="#10151B" BorderBrush="#354453" BorderThickness="1" CornerRadius="8"
                                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No safe preview samples in this selection" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="Try another analyzed asset set. Technical maps, masks, and protected effects are intentionally not shown as color examples."
                                                   Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- One responsive viewport plus three compact tabs. -->
                                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="Representative texture samples">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,8,0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="#0D1015" />
                                                <Setter Property="BorderBrush" Value="#343943" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="SampleTab" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="7" Padding="8">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="SampleTab" Property="BorderBrush" Value="#59616D" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="SampleTab" Property="Background" Value="#211914" />
                                                                    <Setter TargetName="SampleTab" Property="BorderBrush" Value="{StaticResource LavaBrightBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="66">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#080A0D" CornerRadius="4" ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="9,0,2,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource LavaBrightBrush}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TabStatusText}" FontSize="9" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border x:Name="LiveComparisonSurface" Margin="0,12,0,0" Height="430" MinHeight="400"
                                            Background="#07080B" BorderBrush="#393F49" BorderThickness="1"
                                            CornerRadius="8" ClipToBounds="True"
                                            AutomationProperties.Name="Draggable original and enhanced reveal comparison"
                                            AutomationProperties.HelpText="Drag horizontally to reveal the enhanced texture over the original.">
                                        <Grid ClipToBounds="True">
                                            <Viewbox x:Name="ComparisonViewbox" Stretch="Uniform" StretchDirection="Both"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid x:Name="ComparisonImageStage"
                                                      Width="{Binding SelectedSample.SourceWidth}"
                                                      Height="{Binding SelectedSample.SourceHeight}">
                                                    <Image x:Name="OriginalPreviewImage" Source="{Binding SelectedSample.OriginalImage}" Stretch="Fill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Image x:Name="EnhancedPreviewImage" Source="{Binding SelectedSample.EnhancedImage}" Stretch="Fill"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Clip>
                                                            <MultiBinding Converter="{StaticResource RevealClipConverter}">
                                                                <Binding ElementName="ComparisonImageStage" Path="ActualWidth" />
                                                                <Binding ElementName="ComparisonImageStage" Path="ActualHeight" />
                                                                <Binding Path="RevealPercent" />
                                                            </MultiBinding>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Viewbox>

                                            <Grid x:Name="ComparisonInteractionSurface"
                                                  Width="{Binding ActualWidth, ElementName=ComparisonViewbox}"
                                                  Height="{Binding ActualHeight, ElementName=ComparisonViewbox}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Background="Transparent" Cursor="SizeWE"
                                                  MouseLeftButtonDown="OnLiveComparisonMouseLeftButtonDown"
                                                  MouseMove="OnLiveComparisonMouseMove"
                                                  MouseLeftButtonUp="OnLiveComparisonMouseLeftButtonUp"
                                                  LostMouseCapture="OnLiveComparisonLostMouseCapture">
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="4" Background="#D5101217">
                                                    <TextBlock Text="ENHANCED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="4" Background="#DB16372D">
                                                    <TextBlock Text="ORIGINAL" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <Canvas IsHitTestVisible="False">
                                                    <Rectangle x:Name="RevealDivider" Width="2"
                                                               Height="{Binding ActualHeight, ElementName=ComparisonInteractionSurface}"
                                                               Fill="#F7F2E8">
                                                        <Canvas.Left>
                                                            <MultiBinding Converter="{StaticResource RevealPositionConverter}">
                                                                <Binding ElementName="ComparisonInteractionSurface" Path="ActualWidth" />
                                                                <Binding Path="RevealPercent" />
                                                            </MultiBinding>
                                                        </Canvas.Left>
                                                    </Rectangle>
                                                </Canvas>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,7,0,0" Padding="10,7" CornerRadius="5"
                                            Background="#0B0D11" BorderBrush="#363B44" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedSample.Title}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SelectedSample.ProvenanceText}" FontSize="9" Margin="0,3,12,0"
                                                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedSample.SourceDimensionsText}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="  &#x2192;  " FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding SelectedSample.ResultDimensionsText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding ShowOriginalCommand}" Content="Original" Padding="12,7"
                                                    AutomationProperties.Name="Show original texture only" />
                                            <Button Command="{Binding ShowSplitCommand}" Content="50 / 50" Padding="12,7" Margin="6,0,0,0"
                                                    AutomationProperties.Name="Show split original and enhanced comparison" />
                                            <Button Command="{Binding ShowEnhancedCommand}" Content="Enhanced" Padding="12,7" Margin="6,0,0,0"
                                                    AutomationProperties.Name="Show enhanced texture only" />
                                        </StackPanel>
                                        <Slider x:Name="RevealSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                                Value="{Binding RevealPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SmallChange="1" LargeChange="10"
                                                Margin="18,0" VerticalAlignment="Center" IsSnapToTickEnabled="False"
                                                AutomationProperties.Name="Enhanced image reveal percentage"
                                                AutomationProperties.HelpText="Move right to reveal more of the enhanced image, or drag directly on the preview." />
                                        <Button Grid.Column="2" Command="{Binding NewSamplesCommand}" Padding="11,7"
                                                AutomationProperties.Name="Choose three new safe texture samples" ToolTip="Choose another varied set of three safe textures">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" />
                                                <TextBlock Text="New samples" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Drag the divider for a pixel-aligned overlay. Changing settings keeps these samples so theme differences are easy to judge; New samples chooses another safe trio."
                                               Margin="0,7,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Margin="0,0,5,0" Padding="10,8" CornerRadius="5" Background="#0E1218" BorderBrush="#303A47" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SizingNote}" Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Text="{Binding MipNote}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Margin="5,0,0,0" Padding="10,8" CornerRadius="5" Background="#0E1218" BorderBrush="#303A47" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="ACTUAL PROCESSING ROUTE" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedSample.EffectiveRouteText}" Margin="0,4,0,0" FontSize="10" FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedSample.EffectiveProfileText}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding SelectedSample.ThemeText}" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                <Border Margin="0,6,0,0" Padding="7,3" HorizontalAlignment="Left" CornerRadius="4"
                                                        Background="#3A2310" BorderBrush="#8B5B27" BorderThickness="1"
                                                        Visibility="{Binding HasSelectedFallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="SAFETY FALLBACK USED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="OUTPUT FORECAST" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="Staged pack estimate" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" CornerRadius="5"
                                        Background="{StaticResource SafeDimBrush}" BorderBrush="#275A4A" BorderThickness="1">
                                    <TextBlock Text="LIVE CLIENT UNCHANGED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="EST. OUTPUT" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EstimatedOutputText}" Style="{StaticResource MetricValueStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,2" />
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="TO REPACK" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EstimatedArchivesText}" Style="{StaticResource MetricValueStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,2" />
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="ROUGH TIME" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EstimatedTimeText}" Style="{StaticResource MetricValueStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="5" Background="#0E1014" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding WorkspaceText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding EstimateBasisText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="4,10,4,0" />
                            <Border Margin="0,12,0,0" Padding="11,9" CornerRadius="5" Background="#101720"
                                    BorderBrush="#293D52" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="HARDWARE-AWARE PIPELINE" Style="{StaticResource FieldLabelStyle}"
                                               Foreground="#88BFEF" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding HardwarePerformanceText}" FontSize="10" Foreground="#C7D7E6"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Safety and actions -->
                <StackPanel Grid.Column="2">
                    <Border Background="#21150F" BorderBrush="#7A3920" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#432318" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarningBrush}" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="48,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BACKUP + LEGAL GATE" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="Install only when you mean it" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Foreground="#D8C5B9" FontSize="12" LineHeight="19">
                                SpinTexture is an independent fan utility. EverQuest and related assets remain the property of their respective owners. Only transform files you are authorized to use.
                            </TextBlock>
                            <TextBlock Margin="0,11,0,0" TextWrapping="Wrap" Foreground="#D8C5B9" FontSize="12" LineHeight="19">
                                A real install creates and verifies a reversible backup. After installing, use the SpinTexture play shortcut; LaunchPad validates custom archives back to their originals.
                            </TextBlock>

                            <Border Margin="0,15,0,0" Padding="12" CornerRadius="6" Background="#130E0B" BorderBrush="#553021" BorderThickness="1">
                                <CheckBox IsChecked="{Binding IsLegalAcknowledged}">
                                    <TextBlock TextWrapping="Wrap" Text="I understand that custom client files may be unsupported, and I will review a staged pack before installing." />
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="05 / BUILD" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="Forge your texture pack" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,4" />
                            <TextBlock Text="Start with staging, inspect the report and thumbnails, then opt into an installation."
                                       Style="{StaticResource CaptionStyle}" />

                            <Button Command="{Binding BuildStagedPackCommand}" Style="{StaticResource SafeButtonStyle}" Margin="0,16,0,0" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Build Staged Pack" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Recommended - writes only to the managed workspace" FontSize="10" Foreground="{StaticResource SafeBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <Button Command="{Binding OpenPreviewGalleryCommand}" Margin="0,14,0,0" HorizontalContentAlignment="Center"
                                    Background="#19251F" BorderBrush="#356A57" Foreground="#C9F8E7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Open Preview Gallery" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding PreviewStateText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <Button Command="{Binding OpenPackLibraryCommand}" Margin="0,14,0,0" HorizontalContentAlignment="Center"
                                    Background="#20283A" BorderBrush="#445A87" Foreground="#DCE7FF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Manage Staged Packs" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Check multiple packs, inspect archive contents, or repair only missing textures"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <Button Command="{Binding OpenPackStorageCommand}" Margin="0,14,0,0" HorizontalContentAlignment="Center"
                                    Background="#202C2B" BorderBrush="#3E6B66" Foreground="#D9F5EF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Pack Storage Settings" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Move reusable staged packs to another drive with full SHA-256 verification"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <Button Command="{Binding OpenNativeGraphicsCommand}" Margin="0,14,0,0" HorizontalContentAlignment="Center"
                                    Background="#272316" BorderBrush="#6B5A2E" Foreground="#F2DEA4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Native Graphics / Lighting" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Built-in EQL stencil shadows, advanced lighting, and bloom - no injector or shader DLL"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <Button Command="{Binding InstallLatestPackCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Install Staged Pack" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="One-time archive install - no second AI build" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

                            <Button Command="{Binding PlayEnhancedCommand}" Style="{StaticResource SafeButtonStyle}" Margin="0,14,0,0" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock Text="Play Enhanced EQ" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding InstallHealthText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="Normal play does a quick health check only - no AI and no archive copy" TextWrapping="Wrap" TextAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource SafeBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="RECOVERY" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="Return to vanilla" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Command="{Binding RestoreCommand}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" />
                                        <TextBlock Text="Restore" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding RestoreStateText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Activity dock -->
        <Border x:Name="BuildFooter" Grid.Row="2" Background="#0C0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,15,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource LavaBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding OverallProgressText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LavaBrightBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ProgressCountText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="8" Margin="0,9,0,0" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"
                                  Background="#24272E" Foreground="{StaticResource LavaBrush}" BorderThickness="0" />
                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <TextBlock Text="{Binding CurrentStage}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LavaBrightBrush}" />
                        <TextBlock Text="{Binding ProgressEtaText}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding CurrentItem}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                        <Button Command="{Binding CancelCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="10,6" Content="Cancel" />
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

                <Grid Grid.Column="2" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="ACTIVITY LOG" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Safe workflow telemetry" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <ListBox x:Name="ActivityLogList"
                             Grid.Row="1"
                             Margin="0,8,0,0"
                             ItemsSource="{Binding LogEntries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Timestamp}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Cascadia Mono" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="SAFE"><Setter Property="Foreground" Value="{StaticResource SafeBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="DONE"><Setter Property="Foreground" Value="{StaticResource SafeBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="SCAN"><Setter Property="Foreground" Value="{StaticResource LavaBrightBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#B9BBC0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- Secondary workflows stay inside the main application shell. -->
        <Grid x:Name="SectionOverlay" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="50"
              Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#0C0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="←  Back to Build" Click="BackToBuild_Click"
                            Padding="12,7" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SPINTEXTURE / " Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="SectionTitleText" Text="PACKS" Foreground="{StaticResource LavaBrightBrush}"
                                   FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="One window · reversible workflows · no injection"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ContentControl x:Name="SectionContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
