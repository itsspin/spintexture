<UserControl x:Class="SpinTexture.App.NativeGraphicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#090A0D" Foreground="#F4F0E7" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111318" />
        <SolidColorBrush x:Key="PanelRaised" Color="#171A20" />
        <SolidColorBrush x:Key="PanelInset" Color="#0C0E12" />
        <SolidColorBrush x:Key="Border" Color="#303640" />
        <SolidColorBrush x:Key="Text" Color="#F4F0E7" />
        <SolidColorBrush x:Key="Muted" Color="#B8BBC1" />
        <SolidColorBrush x:Key="Accent" Color="#FF7A32" />
        <SolidColorBrush x:Key="Safe" Color="#65D6A6" />
        <SolidColorBrush x:Key="Warning" Color="#F5C76B" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#242830" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="#46505C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#303640" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#697583" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1C1F25" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{StaticResource PanelRaised}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionDot" Width="24" Height="24" CornerRadius="12"
                                        Background="#101217" BorderBrush="#59616E" BorderThickness="2"
                                        Margin="0,1,15,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="SelectionCheck" Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons" FontSize="12"
                                               Foreground="#090A0D" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#66717E" />
                                <Setter TargetName="Card" Property="Background" Value="#1B1F26" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Background" Value="#211711" />
                                <Setter TargetName="SelectionDot" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="SelectionDot" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="1480" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NATIVE GRAPHICS" Foreground="{StaticResource Accent}"
                           FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Make EQL's built-in lighting easier to use"
                           FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="Choose a safe starting preset or turn on the full native lighting path. SpinTexture previews every change and keeps a verified restore point."
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0"
                           TextWrapping="Wrap" MaxWidth="850" LineHeight="19" />
            </StackPanel>
            <Border Grid.Column="1" Background="#17352B" BorderBrush="#2A6A55"
                    BorderThickness="1" CornerRadius="6" Padding="11,6"
                    VerticalAlignment="Top" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons"
                               Foreground="{StaticResource Safe}" FontSize="12" Margin="0,0,7,0" />
                    <TextBlock Text="EQL NATIVE · NO INJECTOR" Foreground="{StaticResource Safe}"
                               FontSize="10" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,18"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1480" HorizontalAlignment="Stretch">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="23" Background="#19372F">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource Safe}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE NOW" Foreground="{StaticResource Muted}"
                                       FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding CurrentStateTitle}" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding CurrentStateSummary}" Foreground="{StaticResource Muted}"
                                       FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18" />
                            <TextBlock Text="{Binding RestoreAvailabilityText}" Foreground="{StaticResource Safe}"
                                       FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Top" BorderThickness="1"
                                CornerRadius="5" Padding="10,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#202A25" />
                                    <Setter Property="BorderBrush" Value="#365C4F" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStateNeedsAttention}" Value="True">
                                            <Setter Property="Background" Value="#2B2111" />
                                            <Setter Property="BorderBrush" Value="#765D2D" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentStateBadge}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Safe}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStateNeedsAttention}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,22,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="14" Background="#362116">
                        <TextBlock Text="1" Foreground="{StaticResource Accent}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,-1,0,0">
                        <TextBlock Text="Choose the look you want" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Balanced is the recommended starting point. Cinematic enables every verified native feature and costs more GPU performance."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="PresetList"
                         ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                         ItemContainerStyle="{StaticResource PresetItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         IsEnabled="{Binding IsNotBusy}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               Foreground="{StaticResource Text}"
                                               FontSize="20" FontWeight="SemiBold" />
                                    <Border HorizontalAlignment="Right" Padding="8,4" CornerRadius="4"
                                            Background="#202A25">
                                        <TextBlock Text="{Binding ChoiceBadge}" Foreground="{StaticResource Safe}"
                                                   FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding FeatureSummary}" Foreground="#E6D4C8"
                                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Margin="0,9,0,0" />
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="18" />
                                <Border Background="#211B0F" BorderBrush="#4E401F" BorderThickness="1"
                                        CornerRadius="5" Padding="9,6" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding PerformanceNote}" Foreground="{StaticResource Warning}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="#101820" BorderBrush="#2C4658" BorderThickness="1"
                        CornerRadius="8" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding IsCinematicSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Optional Cinematic bloom"
                                       Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BloomChoiceText}" Foreground="{StaticResource Muted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,18,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Enable Bloom"
                                  IsChecked="{Binding IsBloomEnabled, Mode=TwoWay}"
                                  Command="{Binding BloomChangedCommand}"
                                  IsEnabled="{Binding IsNotBusy}"
                                  Foreground="{StaticResource Text}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Enable Bloom for the Cinematic native graphics preset" />
                    </Grid>
                </Border>

                <Grid Margin="0,22,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="14" Background="#362116">
                        <TextBlock Text="2" Foreground="{StaticResource Accent}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,-1,0,0">
                        <TextBlock Text="Review what will change" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PlanSummary}" Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PlannedChanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8" Background="{StaticResource PanelInset}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   FontWeight="SemiBold" Margin="12,10" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentDisplayValue}"
                                                   Foreground="{StaticResource Muted}" FontSize="12"
                                                   HorizontalAlignment="Right" Margin="12,10" />
                                        <TextBlock Grid.Column="2" Text="&#x2192;" Foreground="{StaticResource Accent}"
                                                   FontSize="14" Margin="8,9" />
                                        <TextBlock Grid.Column="3" Text="{Binding PlannedDisplayValue}"
                                                   Foreground="{StaticResource Safe}" FontSize="12"
                                                   FontWeight="Bold" Margin="12,10" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#13211C" BorderBrush="#285442" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <TextBlock Foreground="#C6EBDD" FontSize="11" TextWrapping="Wrap" LineHeight="17">
                                <Run Text="Only eqclient.ini is changed. " FontWeight="Bold" />
                                <Run Text="Texture packs, game archives, UI files, fonts, DLLs, and the game executable are untouched. SpinTexture backs up the managed values before applying." />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <ToggleButton x:Name="TechnicalDetailsToggle" Margin="0,14,0,0"
                              Background="#111820" Foreground="{StaticResource Text}"
                              BorderBrush="#2C4658" BorderThickness="1"
                              HorizontalContentAlignment="Stretch" Cursor="Hand"
                              AutomationProperties.Name="Show technical details and optional GPU finishing">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                               Foreground="#8CCDF5" FontSize="14" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Technical details &amp; optional GPU finishing"
                                                   Foreground="{StaticResource Text}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="See the exact INI values, shadow-distance limit, and optional AMD/NVIDIA finishing notes."
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock x:Name="DisclosureState" Grid.Column="2" Text="SHOW"
                                               Foreground="#9CD2F4" FontSize="10" FontWeight="Bold"
                                               Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#16212A" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#46718A" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#13202A" />
                                    <Setter TargetName="DisclosureState" Property="Text" Value="HIDE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Border Background="#101820" BorderBrush="#2C4658" BorderThickness="1"
                        CornerRadius="8" Padding="15" Margin="0,8,0,0"
                        Visibility="{Binding IsChecked, ElementName=TechnicalDetailsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Current managed values" Foreground="#9CD2F4"
                                       FontSize="11" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding CurrentValues}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1514" BorderBrush="#263D37"
                                                BorderThickness="1" CornerRadius="5" Padding="8,5"
                                                Margin="0,0,7,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                           Foreground="#B8C5C0" FontSize="10" />
                                                <TextBlock Text="  " FontSize="10" />
                                                <TextBlock Text="{Binding DisplayValue, Mode=OneWay}"
                                                           Foreground="{StaticResource Safe}"
                                                           FontSize="10" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SettingsPath}" Foreground="#8D96A2"
                                       FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <Separator Background="#2C4658" Margin="0,13,0,12" />
                            <TextBlock Foreground="#C8DDEB" FontSize="11" TextWrapping="Wrap" LineHeight="18">
                                <Run Text="Shadow distance: " FontWeight="Bold" />
                                <Run Text="Cinematic sets EQL's verified Shadow Clip Plane to 100 (maximum). This extends cast shadows only; it cannot change zone-authored tree or object visibility." />
                            </TextBlock>
                            <TextBlock Foreground="#C8DDEB" FontSize="11" TextWrapping="Wrap"
                                       LineHeight="18" Margin="0,8,0,0">
                                <Run Text="Optional driver finish: " FontWeight="Bold" />
                                <Run Text="AMD Adrenalin can add Display Color Enhancement and Radeon Image Sharpening. NVIDIA can offer RTX Dynamic Vibrance or RTX HDR for supported games. These manual filters process the finished frame and may also affect the UI. SpinTexture does not write driver profiles." />
                            </TextBlock>
                            <TextBlock Foreground="#C8DDEB" FontSize="11" TextWrapping="Wrap"
                                       LineHeight="18" Margin="0,8,0,0">
                                <Run Text="Depth of field: " FontWeight="Bold" />
                                <Run Text="Not enabled because this EQL client does not expose a supported native depth-of-field control." />
                            </TextBlock>
                        </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" MaxWidth="1480" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <Border BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#111820" />
                            <Setter Property="BorderBrush" Value="#294657" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="#281416" />
                                    <Setter Property="BorderBrush" Value="#71383C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" Foreground="#BED9EA"
                               FontSize="11" TextWrapping="Wrap" />
                </Border>
                <ProgressBar Height="4" Margin="0,7,0,0" IsIndeterminate="{Binding IsBusy}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Cancel" Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Restore Previous Settings" Command="{Binding RestoreCommand}"
                        Background="#29313B" BorderBrush="#586474" />
                <Button Content="{Binding ApplyButtonText}" Command="{Binding ApplyCommand}"
                        Margin="0" Background="#9B3B16" BorderBrush="#E2672E" Padding="20,11" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
