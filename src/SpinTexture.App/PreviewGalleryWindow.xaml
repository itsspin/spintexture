<Window x:Class="SpinTexture.App.PreviewGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SpinTexture - Before &amp; After Gallery"
        Width="1480"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#08090C"
        Foreground="#F4F0E7"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111318" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#171A20" />
        <SolidColorBrush x:Key="PanelInsetBrush" Color="#0B0D11" />
        <SolidColorBrush x:Key="BorderBrush" Color="#292E36" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F0E7" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6A8AD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#737780" />
        <SolidColorBrush x:Key="LavaBrush" Color="#FF5A1F" />
        <SolidColorBrush x:Key="LavaBrightBrush" Color="#FF8A3D" />
        <SolidColorBrush x:Key="SafeBrush" Color="#65D6A6" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F5C76B" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource LavaBrightBrush}" />
        </Style>

        <Style x:Key="MutedStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#242830" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#3A414B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#343A45" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5A626F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource LavaBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GalleryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A1D23" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B414B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#271914" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource LavaBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DrawingBrush x:Key="CheckerBrush"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute"
                      TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#12151A" Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing Brush="#181C22" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- Gallery title band -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#24130D" Offset="0" />
                    <GradientStop Color="#111318" Offset="0.42" />
                    <GradientStop Color="#151014" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="560" Height="190" Margin="-210,-125,0,0" HorizontalAlignment="Left" Opacity="0.65">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B44720" Offset="0" />
                        <GradientStop Color="#00141110" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Rectangle Height="2" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FF5A1F" Offset="0" />
                        <GradientStop Color="#FFFF5A1F" Offset="0.19" />
                        <GradientStop Color="#35FF8A3D" Offset="0.7" />
                        <GradientStop Color="#00FF5A1F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="10" VerticalAlignment="Center"
                        Background="#321B12" BorderBrush="#A84925" BorderThickness="1">
                    <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="23"
                               Foreground="{StaticResource LavaBrightBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BEFORE / AFTER REVIEW" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="Texture Preview Gallery" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Judge detail at true 1:1 output pixels, or use Fit for a clearly labeled overview."
                               Style="{StaticResource MutedStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Padding="11,7" Background="#14372C" BorderBrush="#2B715A" BorderThickness="1" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SafeBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="STAGED OUTPUT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding EntryCountText}" Style="{StaticResource MutedStyle}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Selected texture identity -->
        <Border Grid.Row="1" Background="#0D0F13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedEntry.LogicalName, TargetNullValue=Select a texture}"
                               FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="ARCHIVE" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SelectedEntry.ArchivePath, TargetNullValue=No selection}"
                                   Style="{StaticResource MutedStyle}" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,7" CornerRadius="5" Background="#171A20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ORIGINAL" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedEntry.OriginalDimensionsText, TargetNullValue=-}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{StaticResource LavaBrightBrush}" Margin="12,0" VerticalAlignment="Center" />
                    <Border Padding="12,7" CornerRadius="5" Background="#153329" BorderBrush="#2A6A55" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ENHANCED" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource SafeBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedEntry.EnhancedDimensionsText, TargetNullValue=-}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Selectable thumbnail list -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="TEXTURE INDEX" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="{Binding VisibleEntryCountText}" HorizontalAlignment="Right" Style="{StaticResource MutedStyle}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,12">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Filter by texture or archive..." IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding EntriesView}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource GalleryListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="84" Height="70" CornerRadius="4" Background="{StaticResource CheckerBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="4,3,0,0">
                                            <TextBlock Text="{Binding LogicalName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArchiveName}" Style="{StaticResource MutedStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <TextBlock Text="{Binding OriginalDimensionsText}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="  >  " FontSize="9" Foreground="{StaticResource LavaBrightBrush}" />
                                                <TextBlock Text="{Binding EnhancedDimensionsText}" FontSize="9" Foreground="{StaticResource SafeBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#D908090C" CornerRadius="7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No previews available" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding LoadErrorText, TargetNullValue=The manifest contains no preview entries.}"
                                           Style="{StaticResource MutedStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!--
                Pixel-accurate comparison canvas. The preview PNGs share the
                enhanced output dimensions; at Zoom=1 each side is arranged at
                that native size instead of being squeezed into a fixed 520 px
                box and then incorrectly labeled 100%.
            -->
            <Grid Grid.Column="1" Background="#090B0E">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <StackPanel Margin="24" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Width="{Binding PreviewWidth}">
                            <Grid Margin="2,0,2,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#777C85" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="ORIGINAL (MATCHED SIZE)" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedEntry.OriginalDimensionsText}" HorizontalAlignment="Right" Style="{StaticResource MutedStyle}" />
                            </Grid>
                            <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Background="{StaticResource CheckerBrush}"
                                    BorderBrush="#363B44" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="Original preview unavailable" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding SelectedOriginalImage}" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SelectedEntry.OriginalImagePath}" Style="{StaticResource MutedStyle}"
                                       TextTrimming="CharacterEllipsis" Margin="2,9,2,0" ToolTip="{Binding SelectedEntry.OriginalImagePath}" />
                        </StackPanel>

                        <Border Width="32" Background="Transparent" />

                        <StackPanel Width="{Binding PreviewWidth}">
                            <Grid Margin="2,0,2,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource SafeBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="ENHANCED (FULL DETAIL)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedEntry.EnhancedDimensionsText}" HorizontalAlignment="Right" Style="{StaticResource MutedStyle}" />
                            </Grid>
                            <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Background="{StaticResource CheckerBrush}"
                                    BorderBrush="#2A6A55" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="Enhanced preview unavailable" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding SelectedEnhancedImage}" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SelectedEntry.EnhancedImagePath}" Style="{StaticResource MutedStyle}"
                                       TextTrimming="CharacterEllipsis" Margin="2,9,2,0" ToolTip="{Binding SelectedEntry.EnhancedImagePath}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Background="#D80B0D11" CornerRadius="8" Padding="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsImageLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource LavaBrightBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Loading full-resolution comparison..." FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Zoom and inspection footer -->
        <Border Grid.Row="3" Background="#0C0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImageStatusText}" Style="{StaticResource MutedStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PixelScaleDescription}" FontSize="10" Foreground="{StaticResource LavaBrightBrush}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}" Content="-" Width="34" Padding="7" ToolTip="Zoom out" />
                    <Slider Width="180" Minimum="0.125" Maximum="4" SmallChange="0.125" LargeChange="0.5"
                            TickFrequency="0.125" IsSnapToTickEnabled="False" Value="{Binding Zoom}" Margin="12,0"
                            ToolTip="Scale relative to the enhanced output pixels" />
                    <Button Command="{Binding ZoomInCommand}" Content="+" Width="34" Padding="7" ToolTip="Zoom in" />
                    <Button Command="{Binding FitZoomCommand}" Content="Fit" Margin="8,0,0,0" Padding="10,7"
                            ToolTip="Fit the full texture into a 520 px overview" />
                    <Button Command="{Binding ResetZoomCommand}" Content="1:1 Pixels" Margin="6,0,0,0" Padding="10,7"
                            ToolTip="Show the enhanced output at native pixel scale" />
                </StackPanel>
                <Border Grid.Column="2" Padding="10,6" CornerRadius="5" Background="#1A1D23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding ZoomPercentText}" FontFamily="Cascadia Mono" FontSize="11" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
